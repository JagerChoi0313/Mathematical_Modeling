clear; clc; close all;

%% ============================================================
%  问题一第（1）问：基于 rho 和 theta 表达式的纯方位无源定位
%
%  发射无人机：FY00、FYi、FYj
%  接收无人机：P=(rho, theta)
%
%  已知：
%       R          圆形编队半径
%       phi_i      FYi 的圆心角
%       phi_j      FYj 的圆心角
%       alpha_i    angle OPFYi，即 P 看 FY00 和 FYi 的夹角
%       alpha_j    angle OPFYj，即 P 看 FY00 和 FYj 的夹角
%       alpha_ij   angle FYiPFYj，即 P 看 FYi 和 FYj 的夹角
%
%  求：
%       rho        接收无人机到 FY00 的距离
%       theta      接收无人机相对 FY01 方向的圆心角
%       x,y        接收无人机直角坐标
%% ============================================================

%% 1. 建立圆形编队坐标
R = 100;       % 圆形编队半径
N = 9;         % 圆周无人机数量 FY01~FY09

% pos(id+1,:) 表示 FYid 的坐标
% FY00 -> pos(1,:)
% FY01 -> pos(2,:)
% ...
% FY09 -> pos(10,:)
pos = zeros(10,2);
pos(1,:) = [0,0];

for k = 1:N
    phi_k = 2*pi*(k-1)/N;
    pos(k+1,:) = [R*cos(phi_k), R*sin(phi_k)];
end

%% 2. 设置发射无人机与接收无人机
% 三架发射无人机为 FY00、FYi、FYj
iID = 1;      % FY01
jID = 4;      % FY04

% 待定位无人机编号
rxID = 3;     % FY03

% FYi 和 FYj 的圆心角
phi_i = 2*pi*(iID-1)/N;
phi_j = 2*pi*(jID-1)/N;

% FY03 的理想位置
P_ideal = pos(rxID+1,:);

% 为验证算法，假设 FY03 发生偏差
P_true = P_ideal + [4, -6];

% 真实位置对应的 rho 和 theta
rho_true = norm(P_true);
theta_true = atan2(P_true(2), P_true(1));
theta_true = mod(theta_true, 2*pi);

%% 3. 根据真实位置模拟接收夹角
O  = pos(1,:);
Si = pos(iID+1,:);
Sj = pos(jID+1,:);

% alpha_i = angle OPSi
alpha_i = angle_between(O - P_true, Si - P_true);

% alpha_j = angle OPSj
alpha_j = angle_between(O - P_true, Sj - P_true);

% alpha_ij = angle SiPSj
alpha_ij = angle_between(Si - P_true, Sj - P_true);

fprintf('========== 模拟接收夹角 ==========\n');
fprintf('alpha_i  = angle FY00-P-FY%02d = %.6f 度\n', iID, rad2deg(alpha_i));
fprintf('alpha_j  = angle FY00-P-FY%02d = %.6f 度\n', jID, rad2deg(alpha_j));
fprintf('alpha_ij = angle FY%02d-P-FY%02d = %.6f 度\n', ...
    iID, jID, rad2deg(alpha_ij));

%% 4. 根据 rho 和 theta 表达式求候选解
% sigma_i 和 sigma_j 用于表示接收机相对射线 OFYi、OFYj 的侧向关系
sigmaList = [-1, 1];

candidate = [];

for si = sigmaList
    for sj = sigmaList

        lambda_i = si * cot(alpha_i);
        lambda_j = sj * cot(alpha_j);

        A = cos(phi_i) - lambda_i*sin(phi_i) ...
          - cos(phi_j) + lambda_j*sin(phi_j);

        B = sin(phi_i) + lambda_i*cos(phi_i) ...
          - sin(phi_j) - lambda_j*cos(phi_j);

        % A*cos(theta)+B*sin(theta)=0
        theta0 = atan2(-A, B);

        % 因为 tan(theta) 有周期性，所以 theta0 和 theta0+pi 都是候选
        thetaCandidates = [theta0, theta0 + pi];

        for tt = 1:length(thetaCandidates)

            theta = mod(thetaCandidates(tt), 2*pi);

            % 根据 FYi 的表达式计算 rho
            rho_i = R * ( ...
                cos(theta - phi_i) + ...
                si*cot(alpha_i)*sin(theta - phi_i) );

            % 根据 FYj 的表达式计算 rho
            rho_j = R * ( ...
                cos(theta - phi_j) + ...
                sj*cot(alpha_j)*sin(theta - phi_j) );

            % 无误差时 rho_i 和 rho_j 应相等
            % 为增强稳健性，这里取平均
            rho = (rho_i + rho_j)/2;

            % 只保留 rho 为正的候选解
            if rho <= 0
                continue;
            end

            % 转换为直角坐标
            P_est = [rho*cos(theta), rho*sin(theta)];

            % 计算该候选点对应的三组理论夹角
            alpha_i_hat  = angle_between(O  - P_est, Si - P_est);
            alpha_j_hat  = angle_between(O  - P_est, Sj - P_est);
            alpha_ij_hat = angle_between(Si - P_est, Sj - P_est);

            % 角度误差
            err_i  = abs(alpha_i_hat  - alpha_i);
            err_j  = abs(alpha_j_hat  - alpha_j);
            err_ij = abs(alpha_ij_hat - alpha_ij);

            totalErr = err_i + err_j + err_ij;

            % 与理想位置距离，用于最后筛选
            distToIdeal = norm(P_est - P_ideal);

            candidate = [candidate;
                si, sj, theta, rho, P_est(1), P_est(2), ...
                rad2deg(err_i), rad2deg(err_j), rad2deg(err_ij), ...
                totalErr, distToIdeal, abs(rho_i-rho_j)];
        end
    end
end

%% 5. 候选解筛选
if isempty(candidate)
    error('未找到 rho>0 的候选解，请检查输入角度或发射机编号。');
end

% 候选解表头：
% 1 sigma_i
% 2 sigma_j
% 3 theta
% 4 rho
% 5 x
% 6 y
% 7 alpha_i误差/度
% 8 alpha_j误差/度
% 9 alpha_ij误差/度
% 10 总角度误差/弧度
% 11 距理想位置距离
% 12 rho_i与rho_j差值

% 先按照第三组夹角误差筛选
tolDeg = 1e-6;
valid = candidate(candidate(:,9) < tolDeg, :);

% 如果过严导致没有结果，则放宽为选择第三夹角误差最小的候选
if isempty(valid)
    [~, idxMin] = min(candidate(:,9));
    valid = candidate(idxMin, :);
end

% 若仍有多个候选，选择距离理想位置最近的
[~, idxBest] = min(valid(:,11));
best = valid(idxBest,:);

sigma_i_best = best(1);
sigma_j_best = best(2);
theta_est = best(3);
rho_est = best(4);
P_est = best(5:6);

%% 6. 输出定位结果
fprintf('\n========== 候选解列表 ==========\n');
fprintf('sigma_i sigma_j   theta/deg       rho/m         x/m          y/m       err_ij/deg   distIdeal/m\n');

for k = 1:size(candidate,1)
    fprintf('%7.0f %7.0f %12.6f %12.6f %12.6f %12.6f %12.6e %12.6f\n', ...
        candidate(k,1), candidate(k,2), rad2deg(candidate(k,3)), ...
        candidate(k,4), candidate(k,5), candidate(k,6), ...
        candidate(k,9), candidate(k,11));
end

fprintf('\n========== 最终定位结果 ==========\n');
fprintf('待定位无人机：FY%02d\n', rxID);
fprintf('sigma_i = %.0f, sigma_j = %.0f\n', sigma_i_best, sigma_j_best);

fprintf('\n真实位置：\n');
fprintf('rho_true   = %.6f m\n', rho_true);
fprintf('theta_true = %.6f 度\n', rad2deg(theta_true));
fprintf('x_true     = %.6f m\n', P_true(1));
fprintf('y_true     = %.6f m\n', P_true(2));

fprintf('\n模型估计位置：\n');
fprintf('rho_est    = %.6f m\n', rho_est);
fprintf('theta_est  = %.6f 度\n', rad2deg(theta_est));
fprintf('x_est      = %.6f m\n', P_est(1));
fprintf('y_est      = %.6f m\n', P_est(2));

fprintf('\n误差：\n');
fprintf('rho误差    = %.12e m\n', abs(rho_est - rho_true));
fprintf('theta误差  = %.12e 度\n', abs(rad2deg(angle_wrap(theta_est - theta_true))));
fprintf('坐标误差   = %.12e m\n', norm(P_est - P_true));

%% 7. 生成结果表
T_candidate = array2table(candidate, ...
    'VariableNames', { ...
    'sigma_i','sigma_j','theta_rad','rho_m','x_m','y_m', ...
    'err_alpha_i_deg','err_alpha_j_deg','err_alpha_ij_deg', ...
    'totalErr_rad','distToIdeal_m','rhoDiff_m'});

disp(' ');
disp('候选解结果表：');
disp(T_candidate);

T_result = table( ...
    ["真实位置"; "模型估计位置"; "理想位置"], ...
    [rho_true; rho_est; norm(P_ideal)], ...
    [rad2deg(theta_true); rad2deg(theta_est); rad2deg(atan2(P_ideal(2),P_ideal(1)))], ...
    [P_true(1); P_est(1); P_ideal(1)], ...
    [P_true(2); P_est(2); P_ideal(2)], ...
    'VariableNames', {'项目','rho_m','theta_deg','x_m','y_m'} );

disp(' ');
disp('定位结果对比表：');
disp(T_result);

%% 8. 绘图
figure('Color','w','Position',[100,100,900,700]);
hold on; grid on; axis equal;

% 画理想圆
thetaPlot = linspace(0,2*pi,500);
plot(R*cos(thetaPlot), R*sin(thetaPlot), 'k--', 'LineWidth', 1.2);

% 画理想无人机位置
plot(pos(:,1), pos(:,2), 'ko', ...
    'MarkerFaceColor','w', 'MarkerSize',7, 'LineWidth',1.2);

% 标注编号
for k = 0:9
    text(pos(k+1,1)+2.5, pos(k+1,2)+2.5, ...
        sprintf('FY%02d',k), 'FontSize',10);
end

% 发射机
plot(O(1),O(2),'kp','MarkerSize',15,'MarkerFaceColor',[0.7 0.7 0.7]);
plot(Si(1),Si(2),'kp','MarkerSize',15,'MarkerFaceColor',[0.7 0.7 0.7]);
plot(Sj(1),Sj(2),'kp','MarkerSize',15,'MarkerFaceColor',[0.7 0.7 0.7]);

% 理想位置、真实位置、估计位置
plot(P_ideal(1),P_ideal(2),'bo','MarkerSize',10,'LineWidth',1.8);
plot(P_true(1),P_true(2),'gx','MarkerSize',13,'LineWidth',2.2);
plot(P_est(1),P_est(2),'rs','MarkerSize',10,'MarkerFaceColor','r');

% 方向观测线
plot([P_true(1), O(1)],  [P_true(2), O(2)],  'k-', 'LineWidth',1.0);
plot([P_true(1), Si(1)], [P_true(2), Si(2)], 'k-', 'LineWidth',1.0);
plot([P_true(1), Sj(1)], [P_true(2), Sj(2)], 'k-', 'LineWidth',1.0);

xlabel('x / m');
ylabel('y / m');
title('问题一第（1）问：基于 \rho 和 \theta 表达式的纯方位定位');

legend('理想圆周','理想编队点','发射无人机', ...
    '发射无人机','发射无人机', ...
    '接收机理想位置','接收机真实位置','模型估计位置','方向观测线', ...
    'Location','bestoutside');

%% ============================
% 局部函数 1：计算两向量夹角
%% ============================
function alpha = angle_between(v1, v2)
    c = dot(v1,v2)/(norm(v1)*norm(v2));
    c = max(min(c,1),-1);
    alpha = acos(c);
end

%% ============================
% 局部函数 2：角度归一化到 [-pi, pi]
%% ============================
function a = angle_wrap(a)
    a = mod(a + pi, 2*pi) - pi;
end